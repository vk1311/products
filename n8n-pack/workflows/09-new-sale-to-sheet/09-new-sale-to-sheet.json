            },
            {
              "id": "7e7f4cbf-76a9-566c-9e8f-c2a0da85c551",
              "name": "amount",
              "value": "={{ ['bif','clp','djf','gnf','jpy','kmf','krw','mga','pyg','rwf','ugx','vnd','vuv','xaf','xof','xpf'].includes($('Stripe: Checkout Completed').item.json.data.object.currency) ? $('Stripe: Checkout Completed').item.json.data.object.amount_total : $('Stripe: Checkout Completed').item.json.data.object.amount_total / 100 }}",
              "type": "number"
            },
            {
              "id": "f9e2aaa8-b4d2-5f18-9bb4-32e4234afbc3",
              "name": "currency",
              "value": "={{ ($('Stripe: Checkout Completed').item.json.data.object.currency || '').toUpperCase() }}",

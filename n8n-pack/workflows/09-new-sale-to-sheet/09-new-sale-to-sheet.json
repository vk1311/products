            },
            {
              "id": "1d5e4505-46de-5c5d-8353-f89895b7c611",
              "name": "email",
              "value": "={{ $('Stripe: Checkout Completed').item.json.data.object.customer_details?.email || $('Stripe: Checkout Completed').item.json.data.object.customer_email || '' }}",

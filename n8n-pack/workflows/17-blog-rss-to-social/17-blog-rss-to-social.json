{
  "name": "17 · New Blog Post → Auto-Share to Social Media",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyHour"
            }
          ]
        },
        "feedUrl": "https://yourbusiness.com/blog/feed"
      },
      "id": "f6c3da09-ba63-5bec-8115-5e0ae126f799",
      "name": "New Blog Post (RSS)",
      "type": "n8n-nodes-base.rssFeedReadTrigger",
      "typeVersion": 1,
      "position": [
        0,
        400
      ],
      "notes": "Put YOUR blog's RSS feed URL here.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "5cc3fd09-8878-52ff-b7c1-f92a9897750c",
              "name": "hashtags",
              "value": "#smallbusiness",
              "type": "string"
            },
            {
              "id": "fc46fff7-5d12-5514-ba73-179354bbda13",
              "name": "telegramChannel",
              "value": "@yourchannel",
              "type": "string"
            },
            {
              "id": "82fffcd5-e6d0-564c-9127-ecc34b443445",
              "name": "linkedinPersonId",
              "value": "YOUR_LINKEDIN_PERSON_ID",
              "type": "string"
            },
            {
              "id": "1e290950-ed9d-5428-8cec-f78e0f3e2e20",
              "name": "facebookPageId",
              "value": "YOUR_FACEBOOK_PAGE_ID",
              "type": "string"
            },
            {
              "id": "d9e184be-7306-5693-bac9-021cb3321bd5",
              "name": "maxAgeHours",
              "value": 48,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "4269e645-7e1f-58e7-9727-9b4cd98ce089",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        400
      ],
      "notes": "Edit these values for your business.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// One post per new article. Old articles are skipped (Config → maxAgeHours) so the first run can't flood your feeds.\nconst cfg = $('Config').first().json;\nconst tags = String(cfg.hashtags || '').trim();\nconst out = [];\n$('New Blog Post (RSS)').all().forEach((item, i) => {\n  const a = item.json;\n  const published = DateTime.fromISO(a.isoDate || '') ;\n  if (published.isValid && DateTime.now().diff(published, 'hours').hours > Number(cfg.maxAgeHours || 48)) return;\n  const title = String(a.title || '').trim();\n  const link = a.link || '';\n  const snippet = String(a.contentSnippet || a.content || '').replace(/\\s+/g, ' ').trim().slice(0, 220);\n  const xBudget = 280 - 25 - (tags ? tags.length + 2 : 0);\n  const xTitle = title.length > xBudget ? title.slice(0, xBudget - 1) + '…' : title;\n  out.push({\n    json: {\n      title, link,\n      xPost: ['New on the blog: ' + xTitle, link, tags].filter(Boolean).join('\\n\\n').slice(0, 1000),\n      longPost: [`📝 New on the blog: ${title}`, snippet ? snippet + (snippet.length >= 220 ? '…' : '') : '', link, tags].filter(Boolean).join('\\n\\n'),\n      snippet,\n    },\n    pairedItem: { item: i },\n  });\n});\nreturn out;\n"
      },
      "id": "2853d86e-cc89-5768-9eb9-b71606e92028",
      "name": "Compose Posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        400
      ]
    },
    {
      "parameters": {
        "text": "={{ $json.xPost }}",
        "additionalFields": {}
      },
      "id": "e50cac63-0219-56c0-b154-900ae8b95a63",
      "name": "Post to X",
      "type": "n8n-nodes-base.twitter",
      "typeVersion": 2,
      "position": [
        760,
        100
      ],
      "credentials": {
        "twitterOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "X account"
        }
      }
    },
    {
      "parameters": {
        "person": "={{ $('Config').first().json.linkedinPersonId }}",
        "text": "={{ $json.longPost }}",
        "shareMediaCategory": "ARTICLE",
        "additionalFields": {
          "originalUrl": "={{ $json.link }}",
          "title": "={{ $json.title }}",
          "description": "={{ $json.snippet }}"
        }
      },
      "id": "fe094a94-cbf8-5d27-8da4-5c3f7e3139bc",
      "name": "Post to LinkedIn",

        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#1f2937;max-width:560px;margin:0 auto;padding:24px\"><p>Hi {{ $('Score Feedback').item.json.firstName }},</p><p>Thanks for taking the time to rate us. We're always trying to improve — if there's one thing that would have made your experience a 10, just reply and let us know.</p><p style=\"margin-top:32px;color:#6b7280;font-size:13px\">{{ $('Config').first().json.businessName }}</p></div>",

    {
      "parameters": {
        "fromEmail": "={{ $('Config').first().json.fromEmail }}",
        "toEmail": "={{ $('Score Feedback').item.json.email }}",
        "subject": "=Thank you, {{ $('Score Feedback').item.json.firstName }}! One small favor?",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#1f2937;max-width:560px;margin:0 auto;padding:24px\"><p>Hi {{ $('Score Feedback').item.json.firstName }},</p><p>Thank you so much for the kind feedback — it made our day!</p><p>Would you be willing to share it on Google? It takes 30 seconds and helps other people find a business they can trust.</p><p style=\"margin:24px 0\"><a href=\"{{ $('Config').first().json.reviewLink }}\" style=\"background:{{ $('Config').first().json.brandColor }};color:#ffffff;padding:12px 22px;border-radius:6px;text-decoration:none;font-weight:bold;display:inline-block\">Post your review</a></p><p>Thank you!</p><p style=\"margin-top:32px;color:#6b7280;font-size:13px\">{{ $('Config').first().json.businessName }}</p></div>",
        "options": {
          "appendAttribution": false,
          "replyTo": "={{ $('Config').first().json.ownerEmail }}"
        }
      },

        "subject": "=⚠️ Unhappy customer: {{ $('Score Feedback').item.json.name }} scored {{ $('Score Feedback').item.json.score }}/10",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#1f2937;max-width:560px;margin:0 auto;padding:24px\"><p><b>{{ $('Score Feedback').item.json.name }}</b> ({{ $('Score Feedback').item.json.email }}) gave a score of <b>{{ $('Score Feedback').item.json.score }}/10</b>.</p><p><b>Their reason:</b><br>{{ $('Score Feedback').item.json.comment || '(no comment)' }}</p><p>A personal call or email in the next 24 hours can turn this around. Just hit Reply.</p><p style=\"margin-top:32px;color:#6b7280;font-size:13px\">{{ $('Config').first().json.businessName }}</p></div>",
        "options": {
          "appendAttribution": false,

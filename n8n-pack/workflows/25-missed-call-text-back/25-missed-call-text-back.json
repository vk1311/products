    {
      "parameters": {
        "chatId": "={{ $('Config').item.json.telegramChatId }}",
        "text": "=📵 <b>Missed call</b> from {{ $('Config').item.json.body.From }}{{ $('Config').item.json.body.CallerCity ? ' (' + $('Config').item.json.body.CallerCity + ')' : '' }}\nThey've been sent an automatic text. Replies arrive in your Twilio number's inbox / messaging webhook.",
        "additionalFields": {

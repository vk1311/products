    {
      "parameters": {
        "fromEmail": "={{ $('Config').first().json.fromEmail }}",
        "toEmail": "={{ $('Customer Details').item.json.email }}",
        "subject": "=3 ways to get the most from {{ $('Config').first().json.businessName }}",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#1f2937;max-width:560px;margin:0 auto;padding:24px\"><p>Hi {{ $('Customer Details').item.json.firstName }},</p><p>A few quick tips our favorite customers swear by:</p><ol><li><b>Tip one</b> — replace with your best advice.</li><li><b>Tip two</b> — e.g. how to book or reorder fast.</li><li><b>Tip three</b> — e.g. follow us for exclusive offers.</li></ol><p>Questions? Hit reply any time.</p><p style=\"margin-top:32px;color:#6b7280;font-size:13px\">{{ $('Config').first().json.businessName }}</p></div>",
        "options": {
          "appendAttribution": false,
          "replyTo": "={{ $('Config').first().json.ownerEmail }}"
        }

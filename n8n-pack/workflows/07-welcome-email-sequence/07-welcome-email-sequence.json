    {
      "parameters": {
        "fromEmail": "={{ $('Config').first().json.fromEmail }}",
        "toEmail": "={{ $json.email }}",
        "subject": "=Welcome to {{ $('Config').first().json.businessName }}, {{ $json.firstName }}! 🎉",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#1f2937;max-width:560px;margin:0 auto;padding:24px\"><p>Hi {{ $json.firstName }},</p><p>Welcome aboard — we're really glad you're here.</p><p>Here's what happens next:</p><ul><li>You'll hear from us only when we have something useful.</li><li>If you ever need help, just reply to this email — it comes straight to us.</li></ul><p style=\"margin:24px 0\"><a href=\"{{ $('Config').first().json.websiteUrl }}\" style=\"background:{{ $('Config').first().json.brandColor }};color:#ffffff;padding:12px 22px;border-radius:6px;text-decoration:none;font-weight:bold;display:inline-block\">Visit our website</a></p><p>Thanks again,</p><p style=\"margin-top:32px;color:#6b7280;font-size:13px\">{{ $('Config').first().json.businessName }}</p></div>",
        "options": {
          "appendAttribution": false,
          "replyTo": "={{ $('Config').first().json.ownerEmail }}"
        }
      },
      "id": "806c0325-23ca-50bf-a2b7-28e06c1814d1",
      "name": "Email 1: Welcome",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        960,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {

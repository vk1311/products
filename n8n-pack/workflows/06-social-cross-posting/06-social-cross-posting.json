      "parameters": {
        "jsCode": "// Builds one version of the post per platform (X is limited to 280 characters).\nconst cfg = $('Config').first().json;\nconst f = $('New Post Form').first().json;\nconst text = String(f['Post text'] || '').trim();\nconst link = String(f['Link (optional)'] || '').trim();\nconst tags = String(cfg.hashtags || '').trim();\nconst full = [text, link, tags].filter(Boolean).join('\\n\\n');\n\n// X counts every link as 23 characters.\nconst xBudget = 280 - (link ? 25 : 0) - (tags ? tags.length + 2 : 0);\nconst xText = (text.length > xBudget ? text.slice(0, xBudget - 1).trimEnd() + '…' : text);\nconst platforms = [].concat(f['Post to'] || []);\nreturn [{\n  json: {\n    full,\n    xPost: [xText, link, tags].filter(Boolean).join('\\n\\n'),\n    link,\n    toX: platforms.includes('X (Twitter)'),\n    toLinkedIn: platforms.includes('LinkedIn'),\n    toFacebook: platforms.includes('Facebook Page'),\n    toTelegram: platforms.includes('Telegram Channel'),\n  },\n}];\n"
      },

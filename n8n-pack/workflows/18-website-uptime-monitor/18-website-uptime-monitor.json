      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a7d24899-ad2c-5d9f-915c-1f4f1e891938",
              "name": "urls",
              "value": "https://yourbusiness.com, https://shop.yourbusiness.com",
              "type": "string"
            },
            {
              "id": "68d2c23e-12f0-55d1-a786-921c18296b17",
              "name": "mustContain",
              "value": "",
              "type": "string"
            },
            {
              "id": "3d513933-ab82-5063-82a1-2814d95d5922",

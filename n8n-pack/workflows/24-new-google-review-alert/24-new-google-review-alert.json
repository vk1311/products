                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "ff4a32bb-7fb1-577b-a828-9c9a06c8ad39",
      "name": "Negative Review?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $('Config').first().json.fromEmail }}",
        "toEmail": "={{ $('Config').first().json.ownerEmail }}",
        "subject": "=⚠️ New {{ $('Find New Reviews').item.json.rating }}-star Google review from {{ $('Find New Reviews').item.json.author }}",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#1f2937;max-width:560px;margin:0 auto;padding:24px\"><p>You've received a <b>{{ $('Find New Reviews').item.json.rating }}-star</b> review on Google:</p><p style=\"font-size:20px;color:#f59e0b;margin:0\">{{ $('Find New Reviews').item.json.stars }}</p><p style=\"border-left:3px solid #e5e7eb;padding-left:12px\"><b>{{ $('Find New Reviews').item.json.author }}</b>: {{ $('Find New Reviews').item.json.text }}</p><p><b>Tips:</b> reply within 24 hours, thank them, acknowledge the issue, and offer to make it right offline. Future customers judge you on the reply as much as the review.</p><p style=\"margin:24px 0\"><a href=\"{{ $('Find New Reviews').item.json.link }}\" style=\"background:{{ $('Config').first().json.brandColor }};color:#ffffff;padding:12px 22px;border-radius:6px;text-decoration:none;font-weight:bold;display:inline-block\">Reply on Google</a></p><p style=\"margin-top:32px;color:#6b7280;font-size:13px\">{{ $('Config').first().json.businessName }}</p></div>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "1b5bbd41-e6c7-5a71-b305-31fe589a1adf",
      "name": "Email Owner: Respond Fast",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1440,
        200
      ],
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {
        "content": "## New Google Review Alert\nChecks your Google Business reviews every 6 hours, posts each new review to Slack, and emails you right away about any bad review so you can respond fast.\n\n### Setup\n1. In Google Cloud Console, create a project, enable **Places API (New)** and create an API key (restrict it to Places API). Google gives a generous free monthly allowance — checking every 6 hours stays well within it.\n2. In n8n, create a **Header Auth** credential: *Name* `X-Goog-Api-Key`, *Value* = your API key. Select it on *Get Google Reviews*.\n3. Find your Place ID with Google's Place ID Finder (search \"Google Place ID Finder\") and paste it into **Config → placeId**.\n4. Fill in the rest of **Config** and pick your **Slack** and **SMTP** credentials.\n5. Click **Activate**. The first live run quietly records your existing reviews; alerts start with the next new one.\n\nFull guide: README.md in this workflow's folder.",
        "height": 543,
        "width": 500,
        "color": 7
      },
      "id": "bbf1930e-e8ac-53b1-b2f0-bb970d594086",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",

    {
      "parameters": {
        "method": "GET",
        "url": "=https://places.googleapis.com/v1/places/{{ $('Config').first().json.placeId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Goog-FieldMask",
              "value": "displayName,rating,userRatingCount,reviews,googleMapsUri"
            }
          ]
        },
        "options": {}
      },
      "id": "1d82495c-8a80-5335-ab99-5ff492d24747",
      "name": "Get Google Reviews",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Google Places API key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Remembers which reviews it has already seen. The first live run just \"learns\" your existing reviews (no alerts).\n// Manual test runs always show your latest review so you can check the formatting.\nconst cfg = $('Config').first().json;\nconst place = $input.first().json;\nconst reviews = place.reviews || [];\nconst state = $getWorkflowStaticData('global');\nconst seen = new Set(state.seen || []);\nconst isTest = $execution.mode !== 'production';\n\nlet fresh = reviews.filter((r) => !seen.has(r.name));\nif (!state.initialised && !isTest) fresh = [];\nif (isTest) fresh = reviews.slice(0, 1);\nif (!isTest) {\n  state.seen = [...new Set([...reviews.map((r) => r.name), ...seen])].slice(0, 500);\n  state.initialised = true;\n}\nconst stars = (n) => '★'.repeat(n) + '☆'.repeat(5 - n);\nreturn fresh.map((r) => {\n  const rating = Number(r.rating || 0);\n  return { json: {\n    rating, stars: stars(rating),\n    author: r.authorAttribution?.displayName || 'A customer',\n    text: r.text?.text || r.originalText?.text || '(no text, rating only)',\n    when: r.relativePublishTimeDescription || '',\n    link: r.googleMapsUri || place.googleMapsUri || '',\n    overall: `${place.rating ?? '?'}★ from ${place.userRatingCount ?? '?'} reviews`,\n    negative: rating <= Number(cfg.alertAtOrBelow ?? 3),\n    test: isTest,\n  } };\n});\n"
      },
      "id": "02abe244-1187-57c5-90f2-d5ef1a844ea6",
      "name": "Find New Reviews",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "={{ $('Config').first().json.slackChannelId }}",
          "mode": "id"
        },
        "text": "={{ $json.negative ? ':rotating_light: *New ' + $json.rating + '-star review — please respond*' : ':tada: *New ' + $json.rating + '-star review!*' }}{{ $json.test ? ' (test run)' : '' }}\n{{ $json.stars }} by *{{ $json.author }}* · {{ $json.when }}\n>{{ $json.text.slice(0, 600) }}\nOverall: {{ $json.overall }} · <{{ $json.link }}|Open on Google>",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "id": "94358e4e-6698-58f4-bdbb-17756c86d124",
      "name": "Post Review to Slack",

    {
      "parameters": {
        "jsCode": "// Accepts JSON or form posts from any website builder (Webflow, WordPress, Wix, Framer, Carrd, plain HTML...).\n// It looks for common field names, so you rarely need to change anything.\nconst cfg = $('Config').first().json;\nreturn $('Lead Webhook').all().map((item, i) => {\n  const b = item.json.body || {};\n  const q = item.json.query || {};\n  const pick = (...keys) => {\n    for (const k of keys) {\n      const v = b[k] ?? q[k];\n      if (v !== undefined && v !== null && String(v).trim() !== '') return String(v).trim();\n    }\n    return '';\n  };\n  let name = pick('name', 'Name', 'full_name', 'fullName', 'your-name');\n  if (!name) name = [pick('first_name', 'firstName', 'fname'), pick('last_name', 'lastName', 'lname')].filter(Boolean).join(' ');\n  const email = pick('email', 'Email', 'email_address', 'your-email').toLowerCase();\n  const honeypot = pick(cfg.honeypotField || 'website_url'); // hidden field humans never fill in = spam bot\n  return {\n    json: {\n      name: name || 'Unknown',\n      email,\n      phone: pick('phone', 'Phone', 'phone_number', 'tel', 'your-phone'),\n      message: pick('message', 'Message', 'comments', 'details', 'your-message'),\n      source: pick('source', 'utm_source', 'Source') || item.json.headers?.referer || 'Website',\n      campaign: pick('utm_campaign', 'campaign'),\n      receivedAt: DateTime.now().setZone(cfg.timezone || 'UTC').toFormat('yyyy-MM-dd HH:mm'),\n      valid: /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email) && !honeypot,\n    },\n    pairedItem: { item: i },\n  };\n});\n"
      },

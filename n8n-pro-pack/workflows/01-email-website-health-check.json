    {
      "id": "a35a9c1d-761b-4cbe-9629-1d1cd33dea3e",
      "name": "Build report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const d = $('Domain to check').first().json.domain;\nconst ans = (n) => (($(n).first().json.Answer) || []).map(a => String(a.data).replace(/^\"|\"$/g, '').replace(/\" \"/g, ''));\nconst txt = ans('Root TXT (SPF)'), dm = ans('DMARC'), mx = ans('MX');\nconst spf = txt.filter(t => t.toLowerCase().startsWith('v=spf1'));\nconst dmarc = dm.find(t => t.toLowerCase().startsWith('v=dmarc1')) || '';\nconst policy = (dmarc.match(/p=(\\w+)/i) || [])[1] || '';\nconst sels = $('DKIM selectors').all().map(i => i.json.selector);\nconst dkimFound = $('DKIM lookup').all().map((it, i) => ((it.json.Answer || []).length ? sels[i] : null)).filter(Boolean);\nconst w = $('Website').first().json; const h = Object.fromEntries(Object.entries(w.headers || {}).map(([k, v]) => [k.toLowerCase(), v]));\nconst sec = ['strict-transport-security', 'content-security-policy', 'x-content-type-options', 'x-frame-options', 'referrer-policy'];\nlet subs = [];\ntry { subs = [...new Set(JSON.parse($('Certificate log (crt.sh)').first().json.data || '[]').flatMap(r => String(r.name_value).split('\\n')))].filter(n => n.endsWith(d) && !n.startsWith('*')).sort(); } catch (e) { subs = null; }\nconst checks = [\n  { item: 'SPF record', ok: spf.length === 1, detail: spf.length === 0 ? 'Missing: other servers can send as you' : spf.length > 1 ? 'More than one SPF record (only one is allowed)' : spf[0] },\n  { item: 'DMARC record', ok: !!dmarc, detail: dmarc || 'Missing: no instruction for spoofed mail' },\n  { item: 'DMARC enforced', ok: /^(quarantine|reject)$/i.test(policy), detail: policy ? 'p=' + policy + (policy === 'none' ? ' (monitoring only, spoofed mail still delivered)' : '') : 'n/a' },\n  { item: 'DKIM signing key', ok: dkimFound.length > 0, detail: dkimFound.length ? 'Found: ' + dkimFound.join(', ') : 'None found on common selectors (may use a custom one)' },\n  { item: 'Receives email (MX)', ok: mx.length > 0, detail: mx.join(', ') || 'No MX record' },\n  { item: 'Website loads over HTTPS', ok: w.statusCode >= 200 && w.statusCode < 400, detail: 'Status ' + (w.statusCode || 'no response') },\n  ...sec.map(k => ({ item: 'Header: ' + k, ok: !!h[k], detail: h[k] ? 'Set' : 'Not set' })),\n];\nconst score = checks.filter(c => c.ok).length;\nreturn [{ json: { domain: d, checkedAt: new Date().toISOString(), score: score + ' of ' + checks.length, checks, subdomainsInCertificateLogs: subs === null ? 'crt.sh did not answer, try again later' : subs } }];\n"
      }
    },
    {
      "id": "2fae9b8d-5fd6-479a-8d56-13912efd9ce9",
      "name": "How to use",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {
        "content": "## Email + website health check\n\n1. Open **Domain to check** and type the domain.\n2. Click **Execute workflow**.\n3. Open **Build report** to read the result: SPF, DKIM, DMARC, MX, HTTPS, five security headers, and subdomains seen in public certificate logs.\n\nNo credentials needed. Uses Google public DNS and crt.sh. Nothing is sent anywhere.\n\nTip: run it on a prospect's domain before a sales call, or monthly on your clients' domains.",
        "color": 4,
        "width": 420,
        "height": 300
      }
    }
